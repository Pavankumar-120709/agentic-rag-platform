# ==============================================================================
# Production Agentic RAG Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Agentic RAG Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL=INFO

# Security & CORS
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=25

# Database Configuration
# For production PostgreSQL with pgvector:
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
# For SQLite local fallback / testing:
# DATABASE_URL=sqlite:///./rag_local.db

# Vector Storage Configuration
VECTOR_DIMENSION=384
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Reranker Configuration
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=5
RETRIEVAL_TOP_K=10
RRF_K=60

# LLM Provider Configuration
# Supported providers: mock, openai, anthropic, google
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Bounded Agentic Workflow Limits
MAX_QUERY_REWRITES=2
MAX_GENERATION_ATTEMPTS=2
CONTEXT_TOKEN_BUDGET=2500
MIN_RELEVANCE_SCORE_THRESHOLD=0.35

# RAGAS Evaluation
RAGAS_LLM_MODEL=gpt-4o-mini
RAGAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
